generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Key-value app settings (company name, SMTP, reminder config...)
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
}

model Supplier {
  id           String     @id @default(cuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  leadTimeDays Int        @default(14)
  notes        String?
  stockItems   StockItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model StockItem {
  id           String    @id @default(cuid())
  name         String
  sku          String?
  category     String    @default("General")
  unit         String    @default("ea")
  qtyOnHand    Float     @default(0)
  reorderPoint Float     @default(0)
  reorderQty   Float     @default(0)
  unitCost     Float     @default(0)
  location     String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bomItems     BomItem[]
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Bill of materials for a standard container build
model BomItem {
  id          String    @id @default(cuid())
  buildType   String    @default("standard_container")
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  qtyPerUnit  Float     @default(1)
}

model AirconModel {
  id                   String          @id @default(cuid())
  brand                String
  model                String
  type                 String          @default("Split inverter")
  btu                  Int             @default(12000)
  serviceIntervalMonths Int            @default(6)
  filterCleanMonths    Int             @default(1)
  supplier             String?
  source               String?
  notes                String?
  equipment            UnitEquipment[]
}

model Unit {
  id           String    @id @default(cuid())
  code         String    @unique
  serial       String?
  type         String    @default("CONTAINER")
  size         String?
  description  String?
  status       String    @default("IN_STOCK")
  client       String?
  site         String?
  outDate      DateTime?
  dueBack      DateTime?
  buildDate    DateTime?
  builder      String?
  electrician  String?
  plumber      String?
  painter      String?
  glazier      String?
  roofer       String?
  otherTrade   String?
  notes        String?
  equipment    UnitEquipment[]
  inspections  Inspection[]
  history      UnitHistory[]
  schedules    MaintenanceSchedule[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model UnitEquipment {
  id            String       @id @default(cuid())
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind          String       @default("AIRCON") // AIRCON | DOOR | WINDOW | FRIDGE | OTHER
  name          String
  airconModelId String?
  airconModel   AirconModel? @relation(fields: [airconModelId], references: [id], onDelete: SetNull)
  serial        String?
  qty           Int          @default(1)
  installedDate DateTime?
  notes         String?
}

model MaintenanceType {
  id                   String                @id @default(cuid())
  key                  String                @unique
  name                 String
  category             String                @default("General")
  defaultIntervalMonths Int                  @default(12)
  description          String?
  active               Boolean               @default(true)
  schedules            MaintenanceSchedule[]
}

// scope: UNIT | EQUIPMENT | GLOBAL | FLEET
model MaintenanceSchedule {
  id             String             @id @default(cuid())
  name           String
  typeId         String
  type           MaintenanceType    @relation(fields: [typeId], references: [id])
  scope          String             @default("UNIT")
  unitId         String?
  unit           Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  equipmentId    String?
  vehicleId      String?
  intervalMonths Int
  lastDone       DateTime?
  nextDue        DateTime?
  responsible    String?
  notes          String?
  active         Boolean            @default(true)
  records        MaintenanceRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model MaintenanceRecord {
  id         String              @id @default(cuid())
  scheduleId String
  schedule   MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date       DateTime
  performedBy String?
  cost       Float?
  findings   String?
  notes      String?
  createdAt  DateTime            @default(now())
}

// category: QCP_STAGE | OUTGOING | RETURN | FLEET
// items: JSON [{ text }]
model InspectionTemplate {
  id          String       @id @default(cuid())
  name        String
  category    String
  stageOrder  Int          @default(0)
  description String?
  items       String
  active      Boolean      @default(true)
  inspections Inspection[]
}

// type: OUTGOING | RETURN | QCP | FLEET
// items: JSON [{ text, result: PASS|FAIL|N/A, notes }]
// signature: PNG data URL signed on tablet
model Inspection {
  id            String             @id @default(cuid())
  unitId        String?
  unit          Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vehicleId     String?
  vehicle       FleetVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  templateId    String?
  template      InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  type          String
  date          DateTime
  inspectorName String
  clientName    String?
  signature     String?
  status        String             @default("PASS")
  findings      String?
  items         String
  createdAt     DateTime           @default(now())
}

model UnitHistory {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String // CREATED | BUILT | MAINTENANCE | INSPECTION | SIGNED_OUT | RETURNED | QCP | NOTE
  description String
  person      String?
  refId       String?
  createdAt   DateTime @default(now())
}

model FleetVehicle {
  id                    String      @id @default(cuid())
  regNo                 String
  make                  String
  model                 String
  type                  String      @default("LDV")
  year                  Int?
  odometerKm            Int         @default(0)
  status                String      @default("ACTIVE") // ACTIVE | IN_WORKSHOP | RETIRED
  assignedTo            String?
  serviceIntervalKm     Int?
  serviceIntervalMonths Int?
  lastServiceDate       DateTime?
  lastServiceOdometerKm Int?
  notes                 String?
  records               FleetRecord[]
  inspections           Inspection[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// type: SERVICE | REPAIR | INSPECTION | TYRES | INCIDENT | OTHER
model FleetRecord {
  id              String       @id @default(cuid())
  vehicleId       String
  vehicle         FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date            DateTime
  type            String       @default("SERVICE")
  description     String
  odometerKm      Int?
  cost            Float?
  workshop        String?
  performedBy     String?
  nextServiceDate DateTime?
  nextServiceKm   Int?
  createdAt       DateTime     @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String?
  status    String // SENT | FAILED | SKIPPED_NO_SMTP | SKIPPED_DISABLED
  error     String?
  createdAt DateTime @default(now())
}
