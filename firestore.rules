rules_version = '2';

// Firestore rules for the Maintenance Manager app.
//
// Data is stored in top-level collections (units, inspections, fleetVehicles,
// stockItems, suppliers, maintenance*, emailLogs, settings, …).
//
// IMPORTANT: these rules are intentionally open so a small team can start
// syncing without any auth setup. They are fine while the project ID stays
// private to the business, but before sharing the app publicly you should
// lock this down (e.g. require Firebase Auth):
//
//   match /{document=**} {
//     allow read, write: if request.auth != null;
//   }
//
// Deploy: firebase deploy --only firestore:rules
// (or paste the rules in Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
