rules_version = '2';

// Firestore rules for the Maintenance Manager app.
//
// Data is stored in top-level collections (units, inspections, fleetVehicles,
// stockItems, suppliers, maintenance*, emailLogs, settings, …).
//
// The app signs in with Firebase **Anonymous Auth** on startup, so every
// device gets request.auth without any login screen. One-time setup in the
// Firebase console: Authentication → Sign-in method → Anonymous → Enable.
// Until that toggle is on, the app cannot sync.
//
// Because the web-app config ships inside the public bundle, these rules do
// NOT allow unrestricted access: only authenticated clients may read/write.
// (Firebase web API keys are public identifiers, not secrets.)
//
// Deploy: firebase deploy --only firestore:rules
// (or paste the rules in Firebase console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
